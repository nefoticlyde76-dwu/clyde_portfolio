{
  "name": "clyde-portfolio",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm run build:vercel && npm run build:netlify",
    "build:vercel": "esbuild public/assets/js/admin-blob-upload.js --bundle --platform=browser --target=es2022 --outfile=public/assets/js/admin-blob-upload.bundle.js",
    "build:netlify": "npm run typecheck && node scripts/build-netlify.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "netlify dev",
    "test:auth": "node --experimental-strip-types --test tests/auth.test.mts",
    "test:content": "node --experimental-strip-types --test tests/content.test.mts"
  },
  "dependencies": {
    "@netlify/blobs": "10.7.13",
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.3",
    "@node-rs/argon2": "^2.2.2",
    "@vercel/blob": "2.8.2",
    "esbuild": "0.27.4"
  },
  "devDependencies": {
    "@netlify/database-dev": "^0.10.1",
    "@types/node": "^22.20.5",
    "netlify-cli": "^27.16.2",
    "typescript": "^6.0.2"
  }
}
